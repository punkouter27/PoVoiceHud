<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- LibraryImport source generator (Credential Manager) emits unsafe stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trimming and Native AOT analyzers: reflection-based JSON and the like fail the build here rather than at run time. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Raffinert.FuzzySharp" />
  </ItemGroup>
</Project>
