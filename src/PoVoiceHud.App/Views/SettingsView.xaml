<UserControl
    x:Class="PoVoiceHud.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoVoiceHud.App.Views">
    <!-- The Settings page: Apply and Cancel follow the form, and stay in view (the form scrolls) when the window is too short for both.
         A top-aligned grid sizes its star row to the content, but no taller than the room there is. -->
    <Grid RowSpacing="12" MaxWidth="532" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Padding="4,0,12,0">
                <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" />

                <!-- First run, or an endpoint or key that stopped working: nothing is heard or checked until this is set -->
                <InfoBar IsOpen="{x:Bind ViewModel.RequiresSetup, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="Connect the fact checker"
                         Message="PoVoiceHud checks claims with an Azure AI Foundry resource that has a gpt-4.1-mini deployment. The microphone stays off until it is connected." />

                <!-- 1. Where the claims are checked: an Azure AI Foundry resource and its key. The model is built in. -->
                <TextBox Header="Azure AI Foundry endpoint" Text="{x:Bind ViewModel.Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="https://&lt;resource&gt;.services.ai.azure.com" />
                <PasswordBox Header="Key" Password="{x:Bind ViewModel.Key, Mode=TwoWay}"
                             PlaceholderText="{x:Bind local:SettingsView.KeyPlaceholder(ViewModel.HasKey), Mode=OneWay}" />
                <TextBlock Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                           Text="Claims are checked by gpt-4.1-mini, so the resource needs a deployment of that name. Apply checks the connection first. The key is kept in Windows Credential Manager." />

                <!-- 2. Optional: code repositories, so claims about the code are checked against their files; one per line -->
                <TextBox Header="Code repositories (optional, one per line)" Text="{x:Bind ViewModel.Repository, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                         PlaceholderText="A GitHub or Azure DevOps URL, or a folder on this PC" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96" />
                <PasswordBox Header="Repository access token" Password="{x:Bind ViewModel.RepositoryToken, Mode=TwoWay}"
                             PlaceholderText="{x:Bind local:SettingsView.TokenPlaceholder(ViewModel.HasRepositoryToken), Mode=OneWay}" />
                <TextBlock Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                           Text="A claim that names a file or class in one is checked against that code. Up to three matching files (the first 6,000 characters of each) go to the model with the claim. A URL is cloned to this PC and refreshed at each start; a private one needs a GitHub or Azure DevOps personal access token with read access to code (one token for all)." />

                <!-- 3. The switches, two by two. The longer explanations are in the tooltips. The call is always heard too. -->
                <Grid ColumnSpacing="12" RowSpacing="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ToggleSwitch Header="Look claims up" IsOn="{x:Bind ViewModel.LookUpClaims, Mode=TwoWay}" MinWidth="0"
                                  AutomationProperties.HelpText="{x:Bind ViewModel.LookUpNote, Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.LookUpNote, Mode=OneWay}" />
                    <ToggleSwitch Grid.Row="1" Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" MinWidth="0" />
                    <ToggleSwitch Grid.Row="2" Header="Listen only during calls" IsOn="{x:Bind ViewModel.CallsOnly, Mode=TwoWay}" MinWidth="0"
                                  ToolTipService.ToolTip="Hear nothing until Teams, Zoom, Slack, Webex, Discord or a browser call has the microphone open, and stop when the call ends" />
                    <ToggleSwitch Grid.Column="1" Header="Sounds and animations" IsOn="{x:Bind ViewModel.Sounds, Mode=TwoWay}" MinWidth="0"
                                  ToolTipService.ToolTip="A short cue for each verdict, answer and mute (each under a quarter of a second, so call audio never transcribes it), and the highlights moving" />
                    <Slider Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Header="Cue volume" Minimum="0" Maximum="100" StepFrequency="5"
                            Value="{x:Bind ViewModel.CueVolume, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Sounds, Mode=OneWay}" VerticalAlignment="Top" />
                    <ToggleSwitch Grid.Row="3" Header="Watch the screen" IsOn="{x:Bind ViewModel.WatchScreen, Mode=TwoWay}" MinWidth="0"
                                  ToolTipService.ToolTip="Every 3 seconds the monitor you are working on is captured; when it has changed, the model describes it, and what is said is checked against what is shown, on the Screen facts page. Pictures go to your Foundry resource and are never saved. The HUD is hidden from captures and screen sharing while this is on." />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. What Apply found, then the buttons: always in view, however short the window -->
        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="6" Padding="4,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:SettingsView.Shown(ViewModel.Message), Mode=OneWay}">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind local:SettingsView.Dot(ViewModel.Message), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Row="1" Content="Quit PoVoiceHud" Click="Quit_Click" />
            <!-- When this copy was built (YYMMDD) and its version, quietly in the corner -->
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BuildStamp}" Style="{StaticResource HudCaption}" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" />
            <Button Grid.Row="1" Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"
                    ToolTipService.ToolTip="Leave the settings as they were (Esc)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Grid.Row="1" Grid.Column="3" Content="Apply" Command="{x:Bind ViewModel.ApplyCommand}" Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Check a new endpoint or key, then save and use these settings" />
        </Grid>
    </Grid>
</UserControl>
