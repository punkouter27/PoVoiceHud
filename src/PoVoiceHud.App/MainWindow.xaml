<winuiex:WindowEx
    x:Class="PoVoiceHud.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    xmlns:local="using:PoVoiceHud.App"
    xmlns:vm="using:PoVoiceHud.Core.ViewModels"
    Title="PoVoiceHud"
    IsAlwaysOnTop="True"
    MinWidth="420"
    MinHeight="320"
    PersistenceId="Hud"
    Width="560"
    Height="560">
    <!-- A standard window (minimize, maximize, close, resizable, snaps), kept on top of other windows so it can sit beside a call.
         The header is drawn into the title bar, so the window's chrome is one 48 px row. In compact mode that row is all there is. -->
    <winuiex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winuiex:WindowEx.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header, in the title bar: mic and level, the headline (latest verdict or status, and the place to drag the window by),
             this session's trend, compact and settings, then room for the caption buttons -->
        <Grid x:Name="Header" Padding="8,0,0,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionSpace" Width="138" />
            </Grid.ColumnDefinitions>
            <!-- A brief red wash across the header when a claim is found incorrect; never in the way of a click -->
            <Border x:Name="Flash" Grid.ColumnSpan="6" Margin="-8,0,0,0" Opacity="0" IsHitTestVisible="False"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
            <!-- Microphone plus a five-bar level meter: the bars light up left to right as you speak, and breathe while a claim
                 is being checked. Click to mute. -->
            <Button x:Name="MicButton" Style="{StaticResource HudIconButton}" Width="NaN" Padding="6,0" Command="{x:Bind ViewModel.ToggleMuteCommand}"
                    IsEnabled="{x:Bind ViewModel.ShowsPages, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind local:MainWindow.MicName(ViewModel.IsMuted), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:MainWindow.MicTip(ViewModel.StatusText, ViewModel.IsMuted), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Grid>
                        <FontIcon Glyph="&#xE720;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  Visibility="{x:Bind local:MainWindow.Not(ViewModel.IsMuted), Mode=OneWay}" />
                        <FontIcon Glyph="&#xEC54;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  Visibility="{x:Bind ViewModel.IsMuted, Mode=OneWay}" />
                    </Grid>
                    <!-- Each bar is dim until the level passes its threshold (see ShowLevel). -->
                    <StackPanel x:Name="LevelBars" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Height="18"
                                AutomationProperties.Name="Microphone level">
                        <StackPanel.Resources>
                            <Style TargetType="Rectangle">
                                <Setter Property="Width" Value="4" />
                                <Setter Property="RadiusX" Value="1" />
                                <Setter Property="RadiusY" Value="1" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                                <Setter Property="Opacity" Value="0.2" />
                            </Style>
                        </StackPanel.Resources>
                        <Rectangle Height="6" />
                        <Rectangle Height="9" />
                        <Rectangle Height="12" />
                        <Rectangle Height="15" />
                        <Rectangle Height="18" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <!-- The drag region: everything in it is passive, so the window moves by the headline -->
            <Grid x:Name="DragArea" Grid.Column="1" Background="Transparent" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}" Style="{StaticResource HudHeadline}" Margin="6,0,0,0"
                           AutomationProperties.HelpText="{x:Bind ViewModel.TallySummary, Mode=OneWay}" />
                <ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"
                              AutomationProperties.Name="Checking a claim" />
            </Grid>
            <!-- The share found correct after each verdict this session; its tooltip has the counts and how the model has done -->
            <Border Grid.Column="2" Background="Transparent" Padding="2,0" VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind ViewModel.HeaderTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.HeaderTip, Mode=OneWay}">
                <Grid Width="44" Height="18">
                    <Line X1="0" X2="44" Y1="9" Y2="9" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                    <Polyline x:Name="Spark" Stroke="{ThemeResource SystemFillColorSuccessBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Border>
            <Button Grid.Column="3" x:Name="CompactButton" Style="{StaticResource HudIconButton}" Command="{x:Bind ViewModel.ToggleCompactCommand}"
                    AutomationProperties.Name="{x:Bind local:MainWindow.CompactName(ViewModel.IsCompact), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:MainWindow.CompactName(ViewModel.IsCompact), Mode=OneWay}">
                <FontIcon Glyph="{x:Bind local:MainWindow.CompactGlyph(ViewModel.IsCompact), Mode=OneWay}" FontSize="14" />
            </Button>
            <Button Grid.Column="4" x:Name="SettingsButton" Style="{StaticResource HudIconButton}" Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                    AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <!-- Bottom edge of the header: this session's verdicts as shares of green, red and amber; its tooltip says how many -->
            <Grid Grid.ColumnSpan="6" Height="3" Margin="-8,0,0,0" VerticalAlignment="Bottom"
                  AutomationProperties.Name="{x:Bind ViewModel.TallySummary, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.HeaderTip, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind local:MainWindow.Share(ViewModel.Supported), Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind local:MainWindow.Share(ViewModel.Contradicted), Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind local:MainWindow.Share(ViewModel.Unverified), Mode=OneWay}" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource SystemFillColorSuccessBrush}" />
                <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCriticalBrush}" />
                <Border Grid.Column="2" Background="{ThemeResource SystemFillColorCautionBrush}" />
            </Grid>
        </Grid>

        <!-- The pages, in one column that keeps a readable width when the window is wide -->
        <Grid Grid.Row="1" x:Name="Panel" Background="{ThemeResource HudScrimBrush}" Padding="8,4,8,8"
              Visibility="{x:Bind local:MainWindow.Not(ViewModel.IsCompact), Mode=OneWay}">
            <Grid MaxWidth="900" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Live, Facts, Code facts or History; on Live the speakers' names, on the two lists their count and Copy -->
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsPages, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="PageSwitch" SelectionChanged="PageSwitch_SelectionChanged" Padding="0">
                        <SelectorBarItem x:Name="LiveTab" Text="Live" ToolTipService.ToolTip="Everything said, with each claim highlighted by its verdict">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE720;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="FactsTab" Text="Facts" ToolTipService.ToolTip="Only the claims found correct or incorrect">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE73E;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="CodeTab" Text="Code" ToolTipService.ToolTip="Code facts: questions about the code repository answered, and statements about it checked">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE943;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="HistoryTab" Text="History" ToolTipService.ToolTip="Past days: what was said and checked, a summary of each meeting, and an export">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE81C;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FactsSummary, Mode=OneWay}" Style="{StaticResource HudCaption}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{x:Bind ViewModel.ShowsFacts, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CodeSummary, Mode=OneWay}" Style="{StaticResource HudCaption}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{x:Bind ViewModel.ShowsCode, Mode=OneWay}" />
                    <!-- Live: what the two sides are called ("Them" becomes "Alex" for this call) -->
                    <DropDownButton Grid.Column="2" Padding="10,4" Visibility="{x:Bind ViewModel.ShowsLive, Mode=OneWay}"
                                    ToolTipService.ToolTip="Name the two sides for this call" AutomationProperties.Name="Speaker names">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE716;" FontSize="13" />
                            <TextBlock Text="Names" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" Width="220">
                                    <TextBox Header="You (the microphone)" Text="{x:Bind ViewModel.Names.You, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Them (the call)" Text="{x:Bind ViewModel.Names.Them, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Grid.Column="2" Click="Copy_Click" IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}" Padding="10,4"
                            Visibility="{x:Bind ViewModel.ShowsList, Mode=OneWay}"
                            ToolTipService.ToolTip="Copy this page's list as filtered, one line each, to paste into notes, a chat or an email">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                            <TextBlock x:Name="CopyText" Text="Copy" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Facts and Code facts: narrow the list by its words (or a speaker's name) and by kind -->
                <Grid Grid.Row="1" ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsList, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Filter by words or a name" Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind vm:HudViewModel.FilterKinds}" SelectedIndex="{x:Bind ViewModel.FilterKind, Mode=TwoWay}"
                              MinWidth="140" AutomationProperties.Name="Show" />
                </Grid>

                <!-- Live: every sentence as it is heard. A claim reads "Checking…" while the model works, then turns green (correct)
                     or red (incorrect) with the reason under it; "can't tell" is a quiet note. Sentences that are not claims are dimmed.
                     A new line slides in. -->
                <Grid Grid.Row="2" x:Name="LivePage" Visibility="{x:Bind ViewModel.ShowsLive, Mode=OneWay}">
                    <ScrollViewer x:Name="LiveScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="What was said, with each claim's verdict">
                        <ItemsRepeater x:Name="LiveList" ItemsSource="{x:Bind ViewModel.Live}" ElementPrepared="Live_ElementPrepared">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:LiveLineViewModel">
                                    <Border Padding="10,6" CornerRadius="6" Background="{x:Bind local:MainWindow.LineBack(State), Mode=OneWay}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource HudLine}" Foreground="{x:Bind local:MainWindow.LineText(State), Mode=OneWay}">
                                                <Run Text="{x:Bind Stamp}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{x:Bind Speaker, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <Run Text="{x:Bind Text}" />
                                            </TextBlock>
                                            <Grid ColumnSpacing="6" Visibility="{x:Bind HasNote, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind local:MainWindow.LineGlyph(State), Mode=OneWay}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"
                                                          Foreground="{x:Bind local:MainWindow.LineFore(State), Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource HudCaption}"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock Text="Listening. What you say appears here, and each claim is checked as you go: green is correct, red is incorrect."
                               Visibility="{x:Bind ViewModel.NoLive, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" />
                </Grid>

                <!-- Facts: only the claims found correct or incorrect, newest first, each with its reason, source and how sure the model was -->
                <Grid Grid.Row="2" x:Name="FactsPage" Visibility="{x:Bind ViewModel.ShowsFacts, Mode=OneWay}">
                    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Verified facts">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ShownFacts}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FactViewModel">
                                    <Border Padding="10,8" CornerRadius="6" Background="{x:Bind local:MainWindow.FactBack(IsCorrect)}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind local:MainWindow.FactGlyph(IsCorrect)}" Foreground="{x:Bind local:MainWindow.FactFore(IsCorrect)}"
                                                      FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{x:Bind Label}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource HudCaption}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="{x:Bind Label}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{x:Bind Reason}" />
                                                </TextBlock>
                                                <HyperlinkButton Command="{x:Bind OpenLinkCommand}" Visibility="{x:Bind HasLink}" Style="{StaticResource HudLink}" Margin="-4,0,0,0">
                                                    <TextBlock Text="{x:Bind LinkLabel}" TextTrimming="CharacterEllipsis" />
                                                </HyperlinkButton>
                                                <ProgressBar Value="{x:Bind local:MainWindow.Percent(Confidence)}" Width="96" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                             ToolTipService.ToolTip="{x:Bind ConfidenceText}" AutomationProperties.Name="{x:Bind ConfidenceText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Bind Time, Mode=OneWay}" Style="{StaticResource HudCaption}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind Speaker, Mode=OneWay}" Style="{StaticResource HudCaption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock Text="{x:Bind ViewModel.NoFactsHint, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.NoFacts, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" />
                </Grid>

                <!-- Code facts: questions about the code repository and their answers, statements about it and their verdicts, newest
                     first, each with the files it rests on (on GitHub or Azure DevOps, and in VS Code at the line) -->
                <Grid Grid.Row="2" x:Name="CodePage" Visibility="{x:Bind ViewModel.ShowsCode, Mode=OneWay}">
                    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Code facts">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ShownCodeFacts}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CodeFactViewModel">
                                    <Border Padding="10,8" CornerRadius="6" Background="{x:Bind local:MainWindow.CodeBack(Verdict)}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind local:MainWindow.CodeGlyph(Verdict)}" Foreground="{x:Bind local:MainWindow.CodeFore(Verdict)}"
                                                      FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{x:Bind Label}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Topic}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource HudCaption}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="{x:Bind Label}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{x:Bind Text}" />
                                                </TextBlock>
                                                <!-- The files it rests on, each with an icon for its kind: on GitHub or Azure DevOps, or in VS Code at the line -->
                                                <ItemsRepeater ItemsSource="{x:Bind Sources}" Visibility="{x:Bind HasSources}" Margin="-4,2,0,0">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CodeSourceViewModel">
                                                            <StackPanel Orientation="Horizontal">
                                                                <HyperlinkButton Command="{x:Bind OpenCommand}" Style="{StaticResource HudLink}" ToolTipService.ToolTip="{x:Bind Path}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{x:Bind Label}" /><Run Text="  " /><Run Text="{x:Bind Folder}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </HyperlinkButton>
                                                                <HyperlinkButton Command="{x:Bind OpenInEditorCommand}" Style="{StaticResource HudLink}" Content="VS Code"
                                                                                 ToolTipService.ToolTip="Open in VS Code at the line it is about" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                                <ProgressBar Value="{x:Bind local:MainWindow.Percent(Confidence)}" Width="96" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                             ToolTipService.ToolTip="{x:Bind ConfidenceText}" AutomationProperties.Name="{x:Bind ConfidenceText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource HudCaption}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind Speaker, Mode=OneWay}" Style="{StaticResource HudCaption}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind Repository}" Style="{StaticResource HudCaption}" HorizontalAlignment="Right"
                                                           Visibility="{x:Bind local:MainWindow.Shown(Repository)}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock Text="{x:Bind ViewModel.NoCodeHint, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.NoCodeFacts, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" />
                </Grid>

                <!-- History: any day's lines and verdicts from the session log, searchable, with the meeting's summary and an export -->
                <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="HistoryPage" RowSpacing="6" Visibility="{x:Bind ViewModel.ShowsHistory, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Bind ViewModel.History.Days, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.History.DayIndex, Mode=TwoWay}"
                                  MinWidth="140" PlaceholderText="No history yet" AutomationProperties.Name="Day" />
                        <TextBox Grid.Column="1" PlaceholderText="Search this day" Text="{x:Bind ViewModel.History.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search this day" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.History.SummarizeCommand, Mode=OneWay}" Padding="10,4"
                                ToolTipService.ToolTip="Sum up this day's meeting with the model: main points, decisions, corrections, open questions and the code">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                                <TextBlock Text="Summary" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Command="{x:Bind ViewModel.History.ExportCommand, Mode=OneWay}" Padding="10,4"
                                ToolTipService.ToolTip="Save this day, with its summary, as a Markdown document and open it">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.History.Message, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                                   Visibility="{x:Bind local:MainWindow.Shown(ViewModel.History.Message), Mode=OneWay}" />
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.History.IsSummarizing, Mode=OneWay}" />
                        <Expander Header="Summary of the meeting" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True"
                                  Visibility="{x:Bind ViewModel.History.HasSummary, Mode=OneWay}">
                            <ScrollViewer MaxHeight="220" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{x:Bind local:MainWindow.Plain(ViewModel.History.Summary), Mode=OneWay}" Style="{StaticResource HudCaption}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="The day's history">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.History.Rows, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryRow">
                                    <Grid Padding="10,3" CornerRadius="6" ColumnSpacing="6" Background="{x:Bind local:MainWindow.HistoryBack(Kind)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind local:MainWindow.LineGlyph(Kind)}" Foreground="{x:Bind local:MainWindow.LineFore(Kind)}" FontSize="12"
                                                  VerticalAlignment="Top" Margin="0,3,0,0" Visibility="{x:Bind local:MainWindow.Not(IsHeard)}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource HudLine}" FontSize="13">
                                            <Run Text="{x:Bind Time}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Run Text="{x:Bind Speaker}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <Run Text="{x:Bind Text}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>

                <!-- Settings: in the window rather than a flyout, so switching windows to copy a key does not close or apply them -->
                <ContentControl x:Name="SettingsHost" Grid.RowSpan="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False"
                                Visibility="{x:Bind ViewModel.ShowsSettings, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</winuiex:WindowEx>
